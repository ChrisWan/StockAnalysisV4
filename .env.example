# Copy to .env and adjust. Load with: uv run --env-file .env python src/app.py
# None of these are secrets - IBKR authentication happens inside TWS itself.

# Data source:
#   auto / edgar : SEC EDGAR validated fundamentals overlaid on Yahoo market data (default)
#   yahoo        : Yahoo Finance only
#   ibkr         : Interactive Brokers only (TWS must be running)
#   ibkr+yahoo   : IBKR preferred with Yahoo fallback
DATA_PROVIDER=auto

# SEC EDGAR fair-access policy requires a User-Agent identifying you.
# Format: "AppName your-email@example.com"
EDGAR_USER_AGENT="StockAnalysisV4 your-email@example.com"

# Interactive Brokers (only used with DATA_PROVIDER=ibkr / ibkr+yahoo).
# TWS paper: 7497 | TWS live: 7496 | Gateway paper: 4002 | Gateway live: 4001
# Defaults to the PAPER port intentionally - switch to 7496 only if you
# deliberately want to connect to a live TWS session.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
# Any number, unique per app connecting to the same TWS instance
IBKR_CLIENT_ID=11

# Flask server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Seconds between symbol requests during a benchmark refresh
BENCHMARK_FETCH_DELAY=1.0

# Python logging level for the app's own log messages
LOG_LEVEL=INFO
